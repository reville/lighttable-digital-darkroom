#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
set -eu
SCRIPT=$0
LINKS=0
while [ -L "$SCRIPT" ]; do
  LINKS=$((LINKS + 1))
  if [ "$LINKS" -gt 40 ]; then
    echo "lighttable: too many symbolic links" >&2
    exit 1
  fi
  DIRECTORY=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd -P)
  LINK=$(readlink "$SCRIPT")
  case "$LINK" in
    /*) SCRIPT=$LINK ;;
    *) SCRIPT=$DIRECTORY/$LINK ;;
  esac
done
ROOT=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd -P)
# Never create bytecode inside the signed application bundle.
export PYTHONDONTWRITEBYTECODE=1
for bundled_python in "$ROOT/../Resources/Python/bin/python3" \
  "$ROOT/../Resources/Python/bin/python3.13"; do
  if [ -x "$bundled_python" ]; then
    export PYTHONPATH="$ROOT/../Resources/LightTable${PYTHONPATH:+:$PYTHONPATH}"
    exec "$bundled_python" -m lighttable_cli "$@"
  fi
done
DEV_ROOT="$ROOT/../../../.."
if [ -d "$ROOT/lighttable_cli" ]; then
  export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
  if [ -x "$ROOT/.venv/bin/python" ]; then
    exec "$ROOT/.venv/bin/python" -m lighttable_cli "$@"
  fi
elif [ -x "$DEV_ROOT/.venv/bin/python" ] && [ -d "$DEV_ROOT/lighttable_cli" ]; then
  export PYTHONPATH="$DEV_ROOT${PYTHONPATH:+:$PYTHONPATH}"
  exec "$DEV_ROOT/.venv/bin/python" -m lighttable_cli "$@"
else
  echo "lighttable: the application runtime is missing; reinstall LightTable." >&2
  exit 1
fi
exec python3 -m lighttable_cli "$@"
