* text=auto
*.sh text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.icns binary
# Unified patch context preserves upstream whitespace literally.
packaging/*.patch -whitespace
# Content-addressed upstream notices must preserve their exact original bytes.
packaging/snap/native-licenses/objects/* -text -whitespace
